# Copy to .env and fill in. .env is ignored by git and must never be committed.

# Databases (one per service, same cluster locally)
POSTGRES_USER=webchat
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
IDENTITY_DB=identity
SOCIAL_DB=social
CHAT_DB=chat

# Identity
WEBCHAT_JWT_SECRET=change-me-browser
WEBCHAT_JWT_ISSUER=webchat-identity
WEBCHAT_JWT_AUDIENCE=webchat
WEBCHAT_ACCESS_TOKEN_TTL=3600

# Service-to-service tokens
SERVICE_JWT_SECRET=change-me-service
SOCIAL_INTERNAL_AUDIENCE=social-internal
IDENTITY_INTERNAL_AUDIENCE=identity-internal

# Google login (optional; when false both endpoints return 501)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Chat
ATTACHMENT_ROOT=/var/lib/webchat/attachments
ATTACHMENT_PENDING_TTL_HOURS=24
MAX_AUDIO_BYTES=10485760
MAX_FILE_BYTES=26214400
MAX_MESSAGE_CHARS=4000

# Summary (optional; when absent POST /unread-summary returns 503 SUMMARY_UNAVAILABLE)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
