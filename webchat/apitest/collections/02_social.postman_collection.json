      "name": "02.02 - Send Friend Request A -> B (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response contains pending friend request\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.be.a('string').and.not.empty;",
              "    pm.expect(jsonData.status).to.eql(\"pending\");",
              "    pm.expect(jsonData.sender.id).to.eql(pm.environment.get(\"user_a_id\"));",
              "    pm.expect(jsonData.recipient.id).to.eql(pm.environment.get(\"user_b_id\"));",
              "    pm.environment.set(\"friend_request_ab_id\", jsonData.id);",
              "});"
            ]
          }
        }
      ],
