    {
      "name": "02.01 - Friend Request Self-Invite (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "pm.test(\"Error code is SELF_INVITE\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error.code).to.eql(\"SELF_INVITE\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
