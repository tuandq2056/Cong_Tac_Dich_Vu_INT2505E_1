    {
      "name": "03.05 - Download Pending Audio Attachment (Uploader Access 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has private no-store Cache-Control header\", function () {",
              "    var cacheControl = pm.response.headers.get(\"Cache-Control\");",
              "    pm.expect(cacheControl).to.include(\"no-store\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_a_token}}"
          }
