    {
      "name": "03.03 - Upload Audio Attachment (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response contains audio attachment metadata\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.be.a('string').and.not.empty;",
              "    pm.expect(jsonData.kind).to.eql(\"audio\");",
              "    pm.expect(jsonData.byte_size).to.be.a('number').and.above(0);",
              "    pm.environment.set(\"audio_attachment_id\", jsonData.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_a_token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "kind",
              "value": "audio",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": "apitest/fixtures/test_audio.webm"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/conversations/{{direct_conversation_id}}/attachments",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "conversations",
            "{{direct_conversation_id}}",
            "attachments"
          ]
        }
      },
      "response": []
    },
