    {
      "name": "03.07 - Read Ahead Check (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "pm.test(\"Error code is READ_AHEAD\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error.code).to.eql(\"READ_AHEAD\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{user_a_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"through_seq\": 9999\n}",
          "options": {
            "raw": {
              "language": "json"
            }
