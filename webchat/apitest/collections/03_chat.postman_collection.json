  "item": [
    {
      "name": "03.01 - Initial Message History Empty (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Initial message list is empty\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.items).to.be.an('array').that.is.empty;",
              "    pm.expect(jsonData.has_more).to.be.false;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_a_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/conversations/{{direct_conversation_id}}/messages",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "conversations",
            "{{direct_conversation_id}}",
            "messages"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03.02 - Initial Read State (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Initial read state has 0 counts and 0 sequence\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.last_read_seq).to.eql(0);",
              "    pm.expect(jsonData.latest_seq).to.eql(0);",
              "    pm.expect(jsonData.unread_text_count).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_a_token}}"
          }
