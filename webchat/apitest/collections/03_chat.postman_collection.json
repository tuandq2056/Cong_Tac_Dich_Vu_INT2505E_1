    {
      "name": "03.09 - Unread Summary on Empty Status (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Unread summary returns empty status and zero counts\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"empty\");",
              "    pm.expect(jsonData.summary).to.be.null;",
              "    pm.expect(jsonData.source_count).to.eql(0);",
              "    pm.expect(jsonData.omitted_count).to.eql(0);",
              "    pm.expect(jsonData.source_from_seq).to.be.null;",
              "    pm.expect(jsonData.source_to_seq).to.be.null;",
              "});"
            ]
          }
        }
      ],
