    {
      "name": "03.06 - Download Pending Attachment by Outsider (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test(\"Error code is ATTACHMENT_NOT_FOUND or CONVERSATION_NOT_FOUND\", function () {",
              "    var jsonData = pm.response.json();",
              "    var code = jsonData.error.code;",
              "    pm.expect(code === \"ATTACHMENT_NOT_FOUND\" || code === \"CONVERSATION_NOT_FOUND\").to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_b_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/conversations/{{direct_conversation_id}}/attachments/{{audio_attachment_id}}/content",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "conversations",
            "{{direct_conversation_id}}",
            "attachments",
            "{{audio_attachment_id}}",
            "content"
          ]
        }
      },
      "response": []
