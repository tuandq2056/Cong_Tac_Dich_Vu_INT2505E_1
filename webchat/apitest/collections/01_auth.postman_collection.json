    {
      "name": "01.06 - Login User A (Success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"TokenResponse conforms to schema\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.access_token).to.be.a('string').and.not.empty;",
              "    pm.expect(jsonData.token_type).to.eql(\"Bearer\");",
              "    pm.expect(jsonData.expires_in).to.be.a('number').and.at.least(1);",
              "    pm.expect(jsonData.user.id).to.eql(pm.environment.get(\"user_a_id\"));",
              "    pm.expect(jsonData.user.username).to.eql(pm.environment.get(\"user_a_username\"));",
              "    pm.environment.set(\"user_a_token\", jsonData.access_token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
